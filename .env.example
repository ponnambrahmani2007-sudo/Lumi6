# ==============================================================================
# Lumi6 — Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development.
# NEVER commit .env.local or real API credentials to version control.
# ==============================================================================

# Primary AI Provider: Google Gemini
# Obtain a key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Configurable Gemini Model (Default: gemini-3.8-flash)
# Supported options: gemini-3.8-flash, gemini-2.0-flash, or custom fine-tuned endpoints
GEMINI_MODEL=gemini-3.8-flash

# Optional: Alternative OpenAI / Custom Proxy Key
# LUMI6_AI_KEY=your_openai_or_proxy_key_here

# Server Port (Default: 3000)
PORT=3000

# Environment Mode: 'development' | 'production' | 'test'
NODE_ENV=development

# Offline Fallback Mode: 'auto' (detect key) | 'force_offline' (deterministic only)
LUMI6_MODE=auto
